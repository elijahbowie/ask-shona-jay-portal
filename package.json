{
  "name": "ask-shona-jay-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "vite build && tsc -p tsconfig.worker.json",
    "preview": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 migrations apply ask-shona-jay-db --local",
    "e2e:local": "node scripts/local-e2e.mjs",
    "readiness": "node scripts/production-readiness.mjs",
    "seed:preview:dry-run": "node scripts/seed-preview-knowledge.mjs --dry-run",
    "seed:preview:apply": "node scripts/seed-preview-knowledge.mjs --apply",
    "seed:preview:validate": "node scripts/seed-preview-knowledge.mjs --validate",
    "seed:preview:rollback": "node scripts/seed-preview-knowledge.mjs --rollback",
    "seed:expanded:dry-run": "node scripts/seed-expanded-preview-knowledge.mjs --dry-run",
    "seed:expanded:apply": "node scripts/seed-expanded-preview-knowledge.mjs --apply",
    "seed:expanded:validate": "node scripts/seed-expanded-preview-knowledge.mjs --validate",
    "seed:expanded:rollback": "node scripts/seed-expanded-preview-knowledge.mjs --rollback",
    "secrets:check": "node scripts/production-secrets.mjs --check",
    "secrets:push": "node scripts/production-secrets.mjs --push",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.6",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.1.1",
    "dompurify": "^3.4.5",
    "gsap": "^3.14.2",
    "hono": "^4.11.2",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "vite": "^7.2.7",
    "wrangler": "^4.54.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251222.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  }
}
